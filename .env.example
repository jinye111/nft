# A Sepolia JSON-RPC endpoint from a provider such as Alchemy, Infura, or Tenderly.
SEPOLIA_RPC_URL=https://your-sepolia-rpc-url

# Private key for the funded Sepolia account that will deploy MyToken. Never commit this value.
PRIVATE_KEY=0xyour_private_key

# Address of the ERC-20 token that TokenBank accepts (for example, MyToken's deployed address).
TOKEN_ADDRESS=0xyour_token_contract_address

# API key from https://etherscan.io/myapikey for publishing verified source code.
ETHERSCAN_API_KEY=your_etherscan_api_key
